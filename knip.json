{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": ["ssh-keygen"],
  "workspaces": {
    ".": {
      "entry": ["infra/scripts/*.mjs"],
      "project": ["infra/scripts/**/*.mjs"]
    },
    "apps/site": {
      "entry": ["src/_data/*.js", "test/**/*.test.mjs"],
      "project": ["src/**/*.js", "test/**/*.mjs"]
    },
    "apps/web": {
      "entry": ["e2e/*.spec.ts"],
      "project": ["src/**/*.{js,jsx}", "e2e/**/*.ts"]
    },
    "packages/client": {
      "entry": ["test/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/ui": {
      "entry": ["test/*.test.tsx"],
      "project": ["src/**/*.{ts,tsx}", "test/**/*.{ts,tsx}"]
    },
    "packages/contracts": {
      "project": ["src/**/*.ts", "test/**/*.mjs"]
    },
    "packages/design": {
      "entry": ["test/*.test.mjs"],
      "project": ["test/*.test.mjs"]
    },
    "packages/docs": {
      "entry": ["*.test.mjs"],
      "project": ["*.mjs", "src/**/*.mjs"]
    },
    "packages/record": {
      "entry": ["test/**/*.test.mjs"],
      "project": ["src/**/*.mjs", "test/**/*.mjs"]
    },
    "packages/auth": {
      "entry": ["test/**/*.test.mjs"],
      "project": ["src/**/*.mjs", "test/**/*.mjs"]
    },
    "packages/ingest": {
      "entry": ["test/**/*.test.mjs"],
      "project": ["src/**/*.mjs", "test/**/*.mjs"]
    },
    "packages/ledger": {
      "entry": ["test/**/*.test.mjs"],
      "project": ["src/**/*.mjs", "test/**/*.mjs"]
    },
    "packages/collector-door": {
      "entry": ["test/**/*.test.mjs"],
      "project": ["src/**/*.mjs", "test/**/*.mjs"]
    },
    "packages/syndication": {
      "entry": ["test/**/*.test.mjs"],
      "project": ["src/**/*.mjs", "test/**/*.mjs"]
    },
    "packages/outbox": {
      "entry": ["test/**/*.test.mjs"],
      "project": ["src/**/*.mjs", "test/**/*.mjs"]
    },
    "packages/mail": {
      "entry": ["scripts/*.mjs", "test/**/*.test.mjs"],
      "project": ["src/**/*.mjs", "scripts/**/*.mjs", "test/**/*.mjs"]
    },
    "packages/tools": {
      "entry": ["test/**/*.test.mjs"],
      "project": ["src/**/*.mjs", "test/**/*.mjs"]
    },
    "services/collector": {
      "entry": ["src/index.mjs", "test/**/*.test.mjs"],
      "project": ["src/**/*.mjs", "test/**/*.mjs"]
    },
    "services/email-relay": {
      "entry": ["src/index.mjs", "test/**/*.test.mjs"],
      "project": ["src/**/*.mjs", "test/**/*.mjs"]
    },
    "services/jobs": {
      "entry": ["test/**/*.test.mjs"],
      "project": ["src/**/*.mjs", "test/**/*.mjs"]
    },
    "services/mcp": {
      "entry": ["src/index.mjs", "test/**/*.test.mjs"],
      "project": ["src/**/*.mjs", "test/**/*.mjs"]
    },
    "services/migrate": {
      "entry": [
        "src/cli.mjs",
        "src/lambda.mjs",
        "src/seed-dev.mjs",
        "test/**/*.test.mjs"
      ],
      "project": ["src/**/*.mjs", "test/**/*.mjs"]
    },
    "services/scheduler": {
      "entry": ["src/index.mjs", "test/**/*.test.mjs"],
      "project": ["src/**/*.mjs", "test/**/*.mjs"]
    },
    "services/timeline-sync": {
      "entry": ["src/index.mjs", "test/**/*.test.mjs"],
      "project": ["src/**/*.mjs", "test/**/*.mjs"]
    },
    "services/web-api": {
      "entry": ["src/index.mjs", "test/**/*.test.mjs"],
      "project": ["src/**/*.mjs", "test/**/*.mjs"]
    },
    "packages/clan-state": {
      "entry": ["test/**/*.test.mjs"],
      "project": ["src/**/*.mjs", "test/**/*.mjs"]
    },
    "packages/clan-engine": {
      "entry": ["test/**/*.test.mjs"],
      "project": ["src/**/*.mjs", "test/**/*.mjs"]
    },
    "packages/clan": {
      "entry": ["test/**/*.test.mjs"],
      "project": ["src/**/*.mjs", "test/**/*.mjs"]
    },
    "packages/clan-web": {
      "entry": ["src/routes.jsx", "src/App.jsx", "test/**/*.test.{js,jsx}"],
      "project": ["src/**/*.{js,jsx}", "test/**/*.{js,jsx}"],
      "ignoreDependencies": ["@elixir-mcp/design"]
    },
    "packages/feedback": {
      "entry": ["test/**/*.test.mjs"],
      "project": ["src/**/*.mjs", "test/**/*.mjs"]
    }
  }
}
