{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["infra/scripts/*.mjs"],
      "project": ["infra/scripts/**/*.mjs"]
    },
    "apps/site": {
      "entry": ["src/_data/*.js", "test/**/*.test.mjs"],
      "project": ["src/**/*.js", "test/**/*.mjs"]
    },
    "apps/web": {
      "project": ["src/**/*.{js,jsx}"]
    },
    "packages/contracts": {
      "project": ["src/**/*.ts", "test/**/*.mjs"]
    },
    "packages/design": {
      "entry": [],
      "project": []
    },
    "services/auth": {
      "entry": ["test/**/*.test.mjs"],
      "project": ["src/**/*.mjs", "test/**/*.mjs"]
    },
    "services/email-relay": {
      "entry": ["src/index.mjs", "test/**/*.test.mjs"],
      "project": ["src/**/*.mjs", "test/**/*.mjs"]
    },
    "services/ingest": {
      "entry": ["test/**/*.test.mjs"],
      "project": ["src/**/*.mjs", "test/**/*.mjs"]
    },
    "services/jobs": {
      "entry": ["test/**/*.test.mjs"],
      "project": ["src/**/*.mjs", "test/**/*.mjs"]
    },
    "services/mcp": {
      "entry": ["src/index.mjs", "test/**/*.test.mjs"],
      "project": ["src/**/*.mjs", "test/**/*.mjs"]
    },
    "services/migrate": {
      "entry": [
        "src/cli.mjs",
        "src/lambda.mjs",
        "src/seed-dev.mjs",
        "test/**/*.test.mjs"
      ],
      "project": ["src/**/*.mjs", "test/**/*.mjs"]
    },
    "services/scheduler": {
      "entry": ["src/index.mjs", "test/**/*.test.mjs"],
      "project": ["src/**/*.mjs", "test/**/*.mjs"]
    },
    "services/web-api": {
      "entry": ["src/index.mjs", "test/**/*.test.mjs"],
      "project": ["src/**/*.mjs", "test/**/*.mjs"]
    }
  },
  "ignoreBinaries": ["sqlite3"]
}
