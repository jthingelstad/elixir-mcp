{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["infra/scripts/*.mjs"],
      "project": ["infra/scripts/**/*.mjs"]
    },
    "apps/site": {
      "entry": ["src/_data/*.js", "test/**/*.test.mjs"],
      "project": ["src/**/*.js", "test/**/*.mjs"]
    },
    "apps/web": {
      "entry": ["e2e/*.spec.ts"],
      "project": ["src/**/*.{js,jsx}", "e2e/**/*.ts"]
    },
    "packages/client": {
      "entry": ["test/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/ui": {
      "entry": ["test/*.test.tsx"],
      "project": ["src/**/*.{ts,tsx}", "test/**/*.{ts,tsx}"]
    },
    "packages/contracts": {
      "project": ["src/**/*.ts", "test/**/*.mjs"]
    },
    "packages/design": {
      "entry": ["test/*.test.mjs"],
      "project": ["test/*.test.mjs"]
    },
    "packages/docs": {
      "entry": ["*.test.mjs"],
      "project": ["*.mjs", "src/**/*.mjs"]
    },
    "services/auth": {
      "entry": ["test/**/*.test.mjs"],
      "project": ["src/**/*.mjs", "test/**/*.mjs"]
    },
    "services/email-relay": {
      "entry": ["src/index.mjs", "test/**/*.test.mjs"],
      "project": ["src/**/*.mjs", "test/**/*.mjs"]
    },
    "services/ingest": {
      "entry": ["test/**/*.test.mjs"],
      "project": ["src/**/*.mjs", "test/**/*.mjs"]
    },
    "services/jobs": {
      "entry": ["test/**/*.test.mjs"],
      "project": ["src/**/*.mjs", "test/**/*.mjs"]
    },
    "services/mcp": {
      "entry": ["src/index.mjs", "test/**/*.test.mjs"],
      "project": ["src/**/*.mjs", "test/**/*.mjs"]
    },
    "services/migrate": {
      "entry": [
        "src/cli.mjs",
        "src/lambda.mjs",
        "src/seed-dev.mjs",
        "test/**/*.test.mjs"
      ],
      "project": ["src/**/*.mjs", "test/**/*.mjs"]
    },
    "services/scheduler": {
      "entry": ["src/index.mjs", "test/**/*.test.mjs"],
      "project": ["src/**/*.mjs", "test/**/*.mjs"]
    },
    "services/web-api": {
      "entry": ["src/index.mjs", "test/**/*.test.mjs"],
      "project": ["src/**/*.mjs", "test/**/*.mjs"]
    }
  },
  "ignoreBinaries": ["sqlite3"]
}
