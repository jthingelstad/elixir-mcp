# Copy to .env (mode 0600). The .env is ignored by git; this example is not.
# The test account named "acceptance": a person with no address following
# #J2RGCRVG, scope cr:read only, its key minted locally by
# infra/scripts/mint-test-key.mjs and registered by hash through the migrate
# lambda's {test_account} op (acceptance/README.md has the recipe).
ELIXIR_MCP_URL=https://elixir.poapkings.com/mcp
ELIXIR_MCP_TOKEN=svt_replace_me
