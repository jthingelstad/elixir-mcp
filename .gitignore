# Secrets — never tracked. This repo is PUBLIC.
# CR API keys, Fastmail tokens, AWS credentials live only in local .env files
# written by bootstrap scripts (DESIGN.md §7 Secrets, §12).
.env
.env.*
!.env.example

# Node
node_modules/
dist/
*.tsbuildinfo

# macOS
.DS_Store

# Logs
*.log

# Build artifacts
infra/dist/
.backfill-progress.json
.battle-detail-progress.json
.backfill-perf.json
.env.gw2

# Design package test scratch
packages/design/.test-*/

# Playwright
test-results/
playwright-report/
.backfill-*.json

# Card art mirrored for mail (infra/scripts/mirror-card-art.mjs): a
# build artifact, ~15 MB of thumbnails, uploaded by deploy. Never
# committed - the repo is public and this is a cache, not a source.
apps/site/src/assets/cards/

# Mail previews (node packages/mail/scripts/preview.mjs): rendered
# fixtures to open or screenshot, never committed.
packages/mail/.preview/

# Claude Code subagent worktrees (each a full checkout; never part of this one).
.claude/worktrees/

# The contract changelog's index, written by the contracts build from
# packages/contracts/src/changes/ (scripts/changes-index.mjs).
packages/contracts/src/generated/
