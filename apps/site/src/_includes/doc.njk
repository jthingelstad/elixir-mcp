---
layout: base.njk
navActive: docs
---
<div class="docs">
  <nav class="docs__toc" aria-label="Documentation">
    <a href="/docs">All docs</a>
    {%- for d in collections.docs %}
    <a href="{{ d | pageUrl }}"{% if d.data.slug == slug %} aria-current="page"{% endif %}>{{ d.data.navTitle or d.data.title }}</a>
    {%- endfor %}
  </nav>
  <article class="docs__body">
    {{ content | safe }}
  </article>
</div>
