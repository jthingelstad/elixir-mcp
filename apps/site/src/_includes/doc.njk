---
layout: base.njk
navActive: docs
---
{#-
  The docs shell, as the 2026-10-01 design draws it: the rail is the
  apps' rail (the kit's rail classes), with a search box on top and the
  groups from `_data/docGroups.js` as disclosures, each with its Lucide
  glyph. The group you are reading in is open, its pages indented under
  it with the gold rule on the current one; every other group is one row
  that opens in place. The docs home opens Start. The tool families nest
  under Tools while you are inside the reference, with the tools of the
  family you are reading under it. Without JavaScript every group still
  opens (a <details>), and every link works.

  The article carries a breadcrumb (Docs / group / page), the title in
  the display face, the page's lede, the Markdown, then what to read
  next and a way to say something is wrong. "On this page" on the right
  marks the section being read, with an edit link and when the source
  last changed. Below 900px the rail is a disclosure above the content,
  never a drawer over it.
-#}
{#- A tool family's sections are its tools (H3s with the tool's name as
    id) — that is what the outline and the rail's third level list, and
    what a link to a specific tool lands on. -#}
{%- set outline = content | headings(3) if toolFamily else content | headings %}
{%- set body = content | withoutH1 %}
{%- set isTools = slug and ("tools" == slug or "tools-" in slug) %}
{%- set here = collections.docSections | docGroup(section) %}
<div class="siterail siterail--docs">
  <aside class="siterail__nav" data-siterail data-open="false">
    <label class="docs-search">
      {% icon "search", 16 %}
      <input type="search" placeholder="Search the docs" aria-label="Search the docs" data-docs-search autocomplete="off" />
      <kbd>/</kbd>
    </label>
    <button type="button" class="siterail__head" data-rail-toggle aria-expanded="false" aria-controls="docs-rail">
      <span class="siterail__head-title">Docs</span>
      <span class="siterail__head-here">{{ (navTitle or title) if slug else here.label }}</span>
      <span class="siterail__head-meta"><span class="siterail__head-chevron">{% icon "chevron-down", 17 %}</span></span>
    </button>
    <nav class="siterail__list" id="docs-rail" aria-label="Documentation" data-docs-list>
      {%- for s in collections.docSections %}
      <details class="docrail__group" data-docs-group{% if s.key == here.key %} open{% endif %}>
        <summary class="rail__item docrail__summary">
          {% icon s.icon, 16 %}<span class="docrail__label">{{ s.label }}</span>{% icon "chevron-right", 14 %}
        </summary>
        {%- for d in s.pages %}
        {%- if not d.data.toolFamily %}
        <a class="rail__child{% if d.data.slug == slug %} rail__child--on{% endif %}" href="{{ d | pageUrl }}"{% if d.data.slug == slug %} aria-current="page"{% endif %} data-search="{{ (d.data.navTitle or d.data.title) | lower }} {{ d.data.description | lower | esc }}">
          {{- d.data.navTitle or d.data.title }}
          {%- if d.data.slug == "tools" %}<span class="rail__gen" title="Generated from the MCP tool registry">gen</span>{% endif -%}
        </a>
        {#- The tool families under Tools, shown only while you are
            inside the reference, and the tools of the family you are
            reading under it, each a link to its own heading. -#}
        {%- if d.data.slug == "tools" and isTools %}
          {%- for f in s.pages %}{% if f.data.toolFamily %}
          <a class="rail__child docrail__family{% if f.data.slug == slug %} rail__child--on{% endif %}" href="{{ f | pageUrl }}"{% if f.data.slug == slug %} aria-current="page"{% endif %} data-search="{{ f.data.title | lower }} {{ f.data.description | lower | esc }}">{{ f.data.navTitle or f.data.title }}</a>
          {%- if f.data.slug == slug %}{% for h in outline %}
          <a class="rail__child rail__child--deep mono" href="#{{ h.id }}" data-search="{{ h.id }}">{{ h.id }}</a>
          {%- endfor %}{% endif %}
          {%- endif %}{% endfor %}
        {%- endif %}
        {%- endif %}
        {%- endfor %}
      </details>
      {%- endfor %}
    </nav>
    <div class="siterail__foot">
      <p class="docrail__note">Your agent reads these same pages as <code>elixir_docs</code>.</p>
      <div class="siterail__chips">
        <a href="/llms.txt">{% icon "file-text", 14 %}llms.txt</a>
        <a href="/tools.json">{% icon "braces", 14 %}tools.json</a>
        <a href="/feed.xml">{% icon "rss", 14 %}feed.xml</a>
      </div>
    </div>
  </aside>

  <div class="siterail__body">
    <div class="docs-layout">
      <article class="docs__body{% if not slug %} docs__body--home{% endif %}">
        {%- if slug %}
        <nav class="docs__crumb" aria-label="Breadcrumb">
          <a href="/docs">Docs</a>{% icon "chevron-right", 12 %}
          {%- if toolFamily %}<a href="/docs/tools">Tools</a>{% icon "chevron-right", 12 %}{% else %}<span>{{ here.label }}</span>{% icon "chevron-right", 12 %}{% endif %}
          <span aria-current="page">{{ navTitle or title }}</span>
        </nav>
        <h1 class="hero-title docs__title">{{ title }}</h1>
        <p class="docs__lede">{{ lede or description }}</p>
        {%- endif %}
        {{ body | safe }}
        {%- if console %}
        <div class="docs__console">
          {% icon "gauge", 17 %}
          <span>{{ console[0] }}</span>
          <a class="btn btn--sm" href="{{ console[1] }}">{{ console[2] }} {% icon "arrow-right", 15 %}</a>
        </div>
        {%- endif %}
        {%- if slug %}
        {%- set next = collections.docSections | docNext(slug) %}
        <div class="docs__next">
          {%- if next.length %}
          <span class="docs__next-links">Next:
            {%- for n in next %} <a href="{{ n | pageUrl }}">{{ n.data.navTitle or n.data.title }} ›</a>{% if not loop.last %}<span aria-hidden="true"> · </span>{% endif %}{% endfor %}
          </span>
          {%- endif %}
          <a class="docs__wrong" href="/console/account/feedback?context={{ ('Docs: /docs/' + slug) | urlencode }}">{% icon "message-square", 14 %}Something wrong on this page?</a>
        </div>
        {%- endif %}
      </article>

      {%- if slug %}
      <nav class="docs__onpage" aria-label="On this page"{% if outline.length %} data-rail-anchors{% endif %}>
        {%- if outline.length %}
        <div class="label docs__onpage-label">On this page</div>
        <div class="docs__onpage-list">
          {%- for h in outline %}
          <a href="#{{ h.id }}"{% if toolFamily %} class="mono"{% endif %}>{% if toolFamily %}{{ h.id }}{% else %}{{ h.text }}{% endif %}</a>
          {%- endfor %}
        </div>
        {%- endif %}
        <div class="docs__onpage-foot">
          {%- if not toolFamily and slug != "tools" %}
          <a class="docs__onpage-edit" href="{{ page.inputPath | editUrl }}">{% icon "square-pen", 14 %}Edit this page</a>
          {%- else %}
          <span class="docs__onpage-edit">{% icon "wrench", 14 %}Generated from the registry</span>
          {%- endif %}
          <span>Updated {{ page.inputPath | updated }}{% if reviewed %} · Reviewed {{ reviewed }}{% endif %}</span>
        </div>
      </nav>
      {%- endif %}
    </div>
  </div>
</div>

<script defer src="{{ "/assets/site-rail.js" | asset }}"></script>
<script defer src="{{ "/assets/rail-anchors.js" | asset }}"></script>
