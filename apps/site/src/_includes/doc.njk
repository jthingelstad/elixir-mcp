---
layout: base.njk
navActive: docs
---
{#-
  The docs shell, as the redesign's boards draw it. The rail is
  `docs-rail.njk`. The article carries a breadcrumb (Docs / parent / group /
  page), the title, the page's lede, the one callout that says where this
  lives in the app, the chip row of a split guide, the Markdown, the pages
  either side, and a way to say something is wrong. "On this page" on the
  right marks the section being read, with an edit link and when the source
  last changed; on a phone headings simply scroll.

  The session is not known here, so a callout carries both faces: Open while
  signed in, Sign in and back while not. A callout pointing at a public page
  has one face.
-#}
{#- A tool family's sections are its tools (H3s with the tool's name as
    id) — that is what the outline and the rail's third level list, and
    what a link to a specific tool lands on. -#}
{%- set outline = content | headings(3) if toolFamily else content | headings %}
{#- A page that carries the agent exchange (doc-demo.njk) lists it first. -#}
{%- if demo %}{% set outline = [{ id: "ask-in-plain-language", text: "Ask in plain language" }].concat(outline) %}{% endif %}
{%- set body = content | withoutH1 %}
{%- set isTools = slug and ("tools" == slug or "tools-" in slug) %}
{%- set here = collections.docSections | docGroup(section) %}
{%- set railOn = slug %}
{%- set railTop = here.top %}
{%- set railHere = (navTitle or title) if slug else "Home" %}
{%- set railOutline = outline %}
{%- set topLabel = collections.docSections | docTops(examples) %}
<div class="siterail siterail--docs">
  {% include "docs-rail.njk" %}

  <div class="siterail__body">
    <div class="docs-layout">
      <article class="docs__body{% if not slug %} docs__body--home{% endif %}"{% if slug %} data-doc-forwards="{{ slug | docForwards | dump }}"{% endif %}>
        {%- if slug %}
        <nav class="docs__crumb" aria-label="Breadcrumb">
          <a href="/docs">Docs</a>{% icon "chevron-right", 12 %}
          {%- for top in topLabel %}{% if top.key == here.top %}<span>{{ top.label }}</span>{% icon "chevron-right", 12 %}{% endif %}{% endfor %}
          {%- if toolFamily %}<a href="/docs/tools">Tools</a>{% icon "chevron-right", 12 %}{% else %}<span>{{ here.label }}</span>{% icon "chevron-right", 12 %}{% endif %}
          <span aria-current="page">{{ navTitle or title }}</span>
        </nav>
        <h1 class="hero-title docs__title">{{ title }}</h1>
        <p class="docs__lede">{{ lede or description }}</p>
        {%- if callout %}
        <div class="docs__callout">
          <span>{{ callout[0] }}</span>
          {%- if callout[1] == "/data" %}
          <a class="btn btn--sm" href="{{ callout[1] }}">{{ callout[2] }}</a>
          {%- else %}
          <a class="btn btn--sm" data-session-face="in" href="{{ callout[1] }}">{{ callout[2] }}</a>
          <a class="btn btn--sm" data-session-face="out" href="/signin?return_to={{ page.url | urlencode }}">Sign in</a>
          {%- endif %}
        </div>
        {%- endif %}
        {%- if guide %}
        <nav class="docs__guide" aria-label="This guide">
          {%- for g in collections.docs | docGuide(guide) %}
          <a class="chip{% if g.data.slug == slug %} chip--on{% endif %}" href="{{ g | pageUrl }}"{% if g.data.slug == slug %} aria-current="page"{% endif %}>{{ g.data.navTitle or g.data.title }}</a>
          {%- endfor %}
        </nav>
        {%- endif %}
        {%- endif %}
        {%- if demo %}{% include "doc-demo.njk" %}{% endif %}
        {{ body | safe }}
        {%- if slug %}
        {%- set near = collections.docSections | docNeighbours(slug) %}
        <div class="docs__next">
          <span class="docs__next-links">
            {%- if near.prev %}<a href="{{ near.prev | pageUrl }}">&lsaquo; {{ near.prev.data.navTitle or near.prev.data.title }}</a>{% endif %}
            {%- if near.next %}<a class="docs__next-on" href="{{ near.next | pageUrl }}">Next: {{ near.next.data.navTitle or near.next.data.title }} &rsaquo;</a>{% endif %}
          </span>
          <button type="button" class="docs__wrong" data-session-face="in" data-help-open>{% icon "message-square", 14 %}Something wrong on this page?</button>
          <a class="docs__wrong" data-session-face="out" href="/signin?return_to={{ page.url | urlencode }}">{% icon "message-square", 14 %}Something wrong on this page?</a>
        </div>
        {%- endif %}
      </article>

      {%- if slug %}
      <nav class="docs__onpage" aria-label="On this page"{% if outline.length %} data-rail-anchors{% endif %}>
        {%- if outline.length %}
        <div class="label docs__onpage-label">On this page</div>
        <div class="docs__onpage-list">
          {%- for h in outline %}
          <a href="#{{ h.id }}"{% if toolFamily %} class="mono"{% endif %}>{% if toolFamily %}{{ h.id }}{% else %}{{ h.text }}{% endif %}</a>
          {%- endfor %}
        </div>
        {%- endif %}
        <div class="docs__onpage-foot">
          {%- if not toolFamily and slug != "tools" %}
          <a class="docs__onpage-edit" href="{{ page.inputPath | editUrl }}">{% icon "square-pen", 14 %}Edit this page</a>
          {%- else %}
          <span class="docs__onpage-edit">{% icon "wrench", 14 %}Generated from the registry</span>
          {%- endif %}
          <span>Updated {{ page.inputPath | updated }}{% if reviewed %} · Reviewed {{ reviewed }}{% endif %}</span>
        </div>
      </nav>
      {%- endif %}
    </div>
  </div>
</div>

<script defer src="{{ "/assets/site-rail.js" | asset }}"></script>
<script defer src="{{ "/assets/rail-anchors.js" | asset }}"></script>
