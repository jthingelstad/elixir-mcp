<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{{ title }} - {{ site.name }}</title>
    <meta name="description" content="{{ description }}" />
    {%- if noindex %}
    <meta name="robots" content="noindex" />
    {%- endif %}
    <link rel="canonical" href="{{ site.url }}{{ page | pageUrl }}" />
    <meta property="og:title" content="{{ title }} - {{ site.name }}" />
    <meta property="og:description" content="{{ description }}" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="{{ site.url }}{{ page | pageUrl }}" />
    <meta property="og:site_name" content="{{ site.name }}" />
    {#- One share image for the site; the title and description above
        are the per-page half of the card. 1200x630, the size every
        network renders at full width. -#}
    <meta property="og:image" content="{{ site.url }}/assets/og.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="{{ site.name }}: {{ site.tagline }}" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="{{ title }} - {{ site.name }}" />
    <meta name="twitter:description" content="{{ description }}" />
    <meta name="twitter:image" content="{{ site.url }}/assets/og.png" />
    {#- Installable: the same tags as the app shell (apps/web/index.html). -#}
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#1b1630" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="{{ site.name }}" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    {#- Autodiscovery: a feed nobody can find is a feed nobody reads. -#}
    <link rel="alternate" type="application/rss+xml" title="{{ site.name }} updates" href="/feed.xml" />
    <link rel="stylesheet" href="{{ "/assets/site.css" | asset }}" />
    {#- Blocking on purpose: it picks the page's signed-in or signed-out face before the first paint. -#}
    <script src="{{ "/assets/session-hint.js" | asset }}"></script>
    <link rel="alternate" type="application/rss+xml" title="{{ site.name }} updates" href="{{ site.url }}/feed.xml" />
    <link rel="alternate" type="application/feed+json" title="{{ site.name }} updates" href="{{ site.url }}/feed.json" />
  </head>
  <body>
    <div class="kit-shell">
      {#- The top bar: the app's (apps/web/src/shell/Shell.jsx), the same classes
          and the same words, read from ONE list, the kit's manifest
          (packages/ui/src/family.json, here as `familyBar`). This template
          loops over it and holds no product, label or link of its own; a test
          pins that, and pins this bar to the app's.

          This build cannot know the session, so both faces are in the markup
          and session-hint.js, a blocking script in the head, chooses one
          before the first paint. Nothing here is swapped after load. The name
          comes from the hint, and the email is never here. -#}
      <header class="kit-top">
        <div class="kit-top__row">
          {%- set homePlace = familyBar.products[0] %}
          <a class="kit-top__brand" data-session-face="out" href="/" aria-label="{{ familyBar.wordmark }} home">
            <img src="{{ familyBar.logo | asset }}" alt="" width="28" height="28" />
            <span>{{ familyBar.wordmark }}</span>
          </a>
          <a class="kit-top__brand" data-session-face="in" href="{{ homePlace.path }}" aria-label="{{ familyBar.wordmark }}, go to {{ homePlace.label }}">
            <img src="{{ familyBar.logo | asset }}" alt="" width="28" height="28" />
            <span>{{ familyBar.wordmark }}</span>
          </a>
          <nav class="kit-top__out" data-session-face="out" aria-label="Main">
            {%- for place in familyBar.signedOut %}
            <a href="{{ place.path }}"{% if navActive == place.key %} aria-current="page"{% endif %}>{{ place.label }}</a>
            {%- endfor %}
          </nav>
          <nav class="kit-top__nav" data-session-face="in" aria-label="Main">
            {%- for product in familyBar.products %}{% if not product.game %}
            <a href="{{ product.path }}">{% chromeIcon product.icon, 18 %}{{ product.label }}</a>
            {%- endif %}{% endfor %}
          </nav>
          <a class="kit-top__search" data-session-face="in" href="{{ familyBar.search.staticPath }}">
            {% chromeIcon familyBar.search.icon, 18 %}
            <span>{{ familyBar.search.prompt }}</span>
          </a>
          <span class="kit-top__gap"></span>
          <a class="kit-top__link" data-session-face="out" href="{{ familyBar.signIn.path }}">{{ familyBar.signIn.label }}</a>
          <a class="btn btn--sm btn--primary" data-session-face="out" href="{{ familyBar.createAccount.path }}">{{ familyBar.createAccount.label }}</a>
          <button type="button" class="kit-top__icon" data-session-face="in" data-help-open aria-label="{{ familyBar.help.label }}">
            {% chromeIcon familyBar.help.icon, 18 %}
          </button>
          {%- for product in familyBar.products %}{% if product.game %}
          <a class="kit-top__drop" data-session-face="in" href="{{ product.href }}" target="_blank" rel="noopener noreferrer" aria-label="{{ product.action }}, {{ product.about }}, opens in a new window">
            {% chromeIcon product.icon, 18 %}
            {{ product.action }}
          </a>
          {%- endif %}{% endfor %}
          <a class="kit-top__avatar" data-session-face="in" href="{{ familyBar.account.path }}">
            <span class="sr-only">{{ familyBar.account.label }}: </span>
            <span class="chrome__avatar chrome__avatar--hint" aria-hidden="true"></span>
            <span class="kit-top__name chrome__me-name--hint"></span>
          </a>
        </div>
      </header>

      <main class="wrap{% if prose %} wrap--prose{% endif %}">
        {{ content | safe }}
      </main>

      <footer class="kit-foot">
        <nav aria-label="{{ familyBar.wordmark }}" class="kit-foot__links">
          {%- for link in familyBar.foot %}
          <a href="{{ link.path }}">{{ link.label }}</a>
          {%- endfor %}
          {%- for product in familyBar.products %}{% if product.game %}
          <a href="{{ product.href }}" target="_blank" rel="noopener noreferrer">{{ product.action }}</a>
          {%- endif %}{% endfor %}
        </nav>
        <div class="disclaimer">
          <span class="disclaimer__tag">UNOFFICIAL</span>
          <span class="disclaimer__text">
            This material is unofficial and is not endorsed by Supercell. For more
            information see Supercell&rsquo;s Fan Content Policy:
            <a href="https://www.supercell.com/fan-content-policy">www.supercell.com/fan-content-policy</a>.
          </span>
          <span class="disclaimer__family">{{ site.family }}</span>
        </div>
      </footer>

      {#- The phone's tabs, signed in only, as the app draws them. -#}
      <nav class="kit-bottom" data-session-face="in" aria-label="Main, phone">
        {%- for product in familyBar.products %}{% if not product.game %}
        <a href="{{ product.path }}">
          {% chromeIcon product.icon, 22 %}
          <span>{{ product.label }}</span>
        </a>
        {%- endif %}{% endfor %}
        <a href="{{ familyBar.search.staticPath }}">
          {% chromeIcon familyBar.search.icon, 22 %}
          <span>{{ familyBar.search.label }}</span>
        </a>
      </nav>
    </div>
    {#- Help, on a static page: the same drawer as the app's (HelpDrawer.jsx, the
        kit's classes and words), in plain script because the app's bundle is
        too large to load here. Signed in only: the bar's button is the only way
        in. `helpText` is the page's own line; site-help.js posts a note with the
        page riding along. [engineering, 2026-11-06] -#}
    <dialog class="kit-help" data-help aria-labelledby="help-title">
      <div class="kit-help__box">
        <header class="kit-help__head">
          <h2 id="help-title">Help for {{ title }}</h2>
          <button type="button" class="btn btn--sm btn--quiet" aria-label="Close" data-help-close>{% chromeIcon "x", 16 %}</button>
        </header>
        <p>{{ helpText or description }}</p>
        <section>
          <h3>Read more</h3>
          <div class="kit-help__links">
            <a class="btn btn--sm" href="{{ familyBar.docs.path }}">Docs home</a>
            <a class="btn btn--sm" href="/docs/about">About Elixir</a>
          </div>
        </section>
        <form data-help-form data-page="{{ title }}">
          <h3><label for="help-note">Something wrong, or missing?</label></h3>
          <p class="kit-tiny">The page you are on rides along. Every item is answered, and the answer comes to your email and your timeline.</p>
          <p role="status" data-help-done hidden>Received, thank you. Every item is answered, and the answer comes to your email when it lands.</p>
          <textarea id="help-note" rows="4" data-help-note></textarea>
          <p class="kit-form__err" role="alert" data-help-error hidden></p>
          <div class="kit-help__links">
            <button type="submit" class="btn btn--primary" data-help-send disabled>Send</button>
            <a class="btn btn--quiet" href="/settings/feedback">Your feedback and its answers</a>
          </div>
        </form>
      </div>
    </dialog>
    <script defer src="{{ "/assets/site-help.js" | asset }}"></script>
    {#- Tinylytics: a static page is a real document load, so the embed
        records the hit by itself. No pushState bridge is needed here -
        that belongs to the app. Same privacy posture: anonymous only.
        The one tag Tinylytics uses for every site: the site rides in
        data-site and the URL takes no parameters (hits, countries and
        events are the site's Tinylytics settings). -#}
    <script defer src="https://tinylytics.app/js/script.js" data-site="{{ site.tinylyticsId }}"></script>
  </body>
</html>
