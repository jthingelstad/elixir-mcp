<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{ title }} - {{ site.name }}</title>
    <meta name="description" content="{{ description }}" />
    <link rel="canonical" href="{{ site.url }}{{ page | pageUrl }}" />
    <meta property="og:title" content="{{ title }} - {{ site.name }}" />
    <meta property="og:description" content="{{ description }}" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="{{ site.url }}{{ page | pageUrl }}" />
    <meta property="og:site_name" content="{{ site.name }}" />
    {#- One share image for the site; the title and description above
        are the per-page half of the card. 1200x630, the size every
        network renders at full width. -#}
    <meta property="og:image" content="{{ site.url }}/assets/og.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="{{ site.name }}: {{ site.tagline }}" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="{{ title }} - {{ site.name }}" />
    <meta name="twitter:description" content="{{ description }}" />
    <meta name="twitter:image" content="{{ site.url }}/assets/og.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {#- Autodiscovery: a feed nobody can find is a feed nobody reads. -#}
    <link rel="alternate" type="application/rss+xml" title="{{ site.name }} updates" href="/feed.xml" />
    <link rel="stylesheet" href="{{ "/assets/site.css" | asset }}" />
    <link rel="alternate" type="application/rss+xml" title="{{ site.name }} updates" href="{{ site.url }}/feed.xml" />
    <link rel="alternate" type="application/feed+json" title="{{ site.name }} updates" href="{{ site.url }}/feed.json" />
  </head>
  <body>
    <div class="shell">
      {#- The top bar: the kit's Chrome (packages/ui/src/Chrome.tsx), the
          same markup and classes, read from ONE list, the kit's product
          manifest (packages/ui/src/family.json, here as `familyBar`).
          This template loops over it and holds no product, label or link
          of its own; a test pins that, and pins this bar to the kit's.

          THE BAR'S SHAPE NEVER VARIES BY SESSION: the account slot is a
          fixed width everywhere. An app fills it from the session it
          already holds; this build cannot know the session, so it always
          shows "Sign in", and the Console's sign-in page sends a reader
          who is signed in straight on to their console. Nothing here is
          swapped after load. (It once showed "Sign in" and swapped it to
          "Account" when /api/me answered, and the bar read as a glitch.)

          A page names `navActive`: the manifest's docs key lights Docs on the bar; any
          other key lights its item in the site's row below. -#}
      <header class="chrome">
        <div class="chrome__inner">
          <a class="chrome__home" href="/" aria-label="{{ familyBar.wordmark }} home">
            <img class="chrome__logo" src="{{ familyBar.logo | asset }}" alt="" />
            <span class="wordmark">{{ familyBar.wordmark }}</span>
          </a>
          <span class="chrome__rule" aria-hidden="true"></span>
          {#- The places. A document is inside none of them, so none is
              current here; the Console marks Console, Clan marks Clan.
              Glyphs are the Lucide icons the manifest names, drawn the
              way the kit's Icon draws them (the chromeIcon shortcode). -#}
          <nav class="chrome__nav" aria-label="Products">
            {%- for product in familyBar.products %}{% if not product.game %}
            <a class="chrome__product" href="{{ product.path }}">
              {% chromeIcon product.icon, 17 %}
              <span class="chrome__product-label">{{ product.label }}</span>
            </a>
            {%- endif %}{% endfor %}
          </nav>
          {#- Narrow: one button, where you are (Docs, on a docs page) or
              "Menu", opening the sheet below. Which width is showing is a
              media query's decision, never this template's. -#}
          {%- if navActive == familyBar.docs.key %}
          <button type="button" class="chrome__menu" aria-label="Product: {{ familyBar.docs.label }}" aria-expanded="false" aria-controls="chrome-sheet" data-here="true" data-chrome-menu>
            {% chromeIcon familyBar.docs.icon, 17 %}
            <span class="chrome__menu-label">{{ familyBar.docs.label }}</span>
            {% chromeIcon "chevron-down", 16 %}
          </button>
          {%- else %}
          <button type="button" class="chrome__menu" aria-label="Menu" aria-expanded="false" aria-controls="chrome-sheet" data-chrome-menu>
            <span data-menu-open>{% chromeIcon "menu", 20 %}</span><span data-menu-close hidden>{% chromeIcon "x", 20 %}</span>
            <span class="chrome__menu-label">Menu</span>
          </button>
          {%- endif %}
          <div class="chrome__end">
            <a class="chrome__docs" href="{{ familyBar.docs.path }}"{% if navActive == familyBar.docs.key %} aria-current="page"{% endif %}>
              {% chromeIcon familyBar.docs.icon, 17 %}
              <span class="chrome__docs-label">{{ familyBar.docs.label }}</span>
            </a>
            {%- for product in familyBar.products %}{% if product.game %}
            <a class="chrome__play" href="{{ product.href }}" target="_blank" rel="noopener" aria-label="{{ product.action }}, {{ product.about }} (opens {{ product.href | host }} in a new window)">
              {% chromeIcon product.icon, 17 %}
              <span class="chrome__play-label">{{ product.action }}</span>
              {% chromeIcon "arrow-up-right", 14 %}
            </a>
            {%- endif %}{% endfor %}
            <span class="chrome__rule" aria-hidden="true"></span>
            <div class="chrome__account">
              <a class="chrome__signin" href="{{ familyBar.signIn.path }}">
                {% chromeIcon familyBar.signIn.icon, 16 %}
                <span>{{ familyBar.signIn.label }}</span>
              </a>
            </div>
          </div>
        </div>

        <nav class="chrome__sheet" id="chrome-sheet" aria-label="{{ familyBar.wordmark }} menu" data-open="false">
          {%- for product in familyBar.products %}{% if not product.game %}
          <a class="chrome__sheet-item" href="{{ product.path }}">
            {% chromeIcon product.icon, 17 %}
            <span class="chrome__sheet-item-label">{{ product.label }}</span>
          </a>
          {%- endif %}{% endfor %}
          <a class="chrome__sheet-item" href="{{ familyBar.docs.path }}"{% if navActive == familyBar.docs.key %} aria-current="page"{% endif %}>
            {% chromeIcon familyBar.docs.icon, 17 %}
            <span class="chrome__sheet-item-label">{{ familyBar.docs.label }}</span>
          </a>
          {%- for product in familyBar.products %}{% if product.game %}
          <a class="chrome__play" href="{{ product.href }}" target="_blank" rel="noopener" aria-label="{{ product.action }}, {{ product.about }} (opens {{ product.href | host }} in a new window)">
            {% chromeIcon product.icon, 17 %}
            <span class="chrome__play-label">{{ product.action }}</span>
            {% chromeIcon "arrow-up-right", 14 %}
          </a>
          {%- endif %}{% endfor %}
        </nav>
      </header>

      {#- The site's own pages (_data/siteNav.js), under the bar. Not on
          a docs page: there Docs is lit on the bar and the docs carry
          their own rail. -#}
      {%- if navActive != familyBar.docs.key %}
      <nav class="sitenav" aria-label="Site">
        {%- for item in siteNav.pages %}
        <a href="{{ item.path }}"{% if navActive == item.key %} aria-current="page"{% endif %}>{{ item.label }}</a>
        {%- endfor %}
      </nav>
      {%- endif %}

      <main class="wrap{% if prose %} wrap--prose{% endif %}">
        {{ content | safe }}
      </main>

      <footer class="sitefoot">
        <nav class="sitefoot__cols" aria-label="Footer">
          <div class="sitefoot__brand">
            <a class="sitefoot__home" href="/" aria-label="{{ familyBar.wordmark }} home">
              <img src="{{ familyBar.logo | asset }}" alt="" />
              <span class="wordmark">{{ familyBar.wordmark }}</span>
            </a>
            <span class="sitefoot__tagline">{{ siteNav.tagline }}</span>
          </div>
          {%- set foot = siteNav.footer %}
          <div class="sitefoot__col">
            <span class="sitefoot__head">{{ foot.elixir.label }}</span>
            {%- for link in foot.elixir.links %}
            <a href="{{ link.path }}">{{ link.label }}</a>
            {%- endfor %}
          </div>
          <div class="sitefoot__col">
            <span class="sitefoot__head">{{ foot.places.label }}</span>
            {%- for product in familyBar.products %}
            {%- if product.external %}
            <a href="{{ product.href }}" target="_blank" rel="noopener" aria-label="{{ product.label }} (opens {{ product.href | host }} in a new window)">{{ product.label }}</a>
            {%- else %}
            <a href="{{ product.path }}">{{ product.label }}</a>
            {%- endif %}
            {%- endfor %}
          </div>
          <div class="sitefoot__col">
            <span class="sitefoot__head">{{ foot.policy.label }}</span>
            {%- for link in foot.policy.links %}
            <a href="{{ link.path }}">{{ link.label }}</a>
            {%- endfor %}
          </div>
        </nav>
        <div class="disclaimer">
          <span class="disclaimer__tag">UNOFFICIAL</span>
          <span class="disclaimer__text">
            This material is unofficial and is not endorsed by Supercell. For more
            information see Supercell&rsquo;s Fan Content Policy:
            <a href="https://www.supercell.com/fan-content-policy">www.supercell.com/fan-content-policy</a>.
          </span>
          <span class="disclaimer__family">{{ site.family }}</span>
        </div>
      </footer>
    </div>
    {#- Tinylytics: a static page is a real document load, so the embed
        records the hit by itself. No pushState bridge is needed here -
        that belongs to the app. Same privacy posture: anonymous only. -#}
    {#- The narrow menu. External file, never inline: the CSP forbids
        inline script and a test pins that. -#}
    <script defer src="{{ "/assets/chrome-menu.js" | asset }}"></script>
    <script defer src="https://tinylytics.app/embed/{{ site.tinylyticsId }}/min.js?hits&countries&events"></script>
  </body>
</html>
