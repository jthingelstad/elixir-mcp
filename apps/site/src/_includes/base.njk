<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{ title }} - {{ site.name }}</title>
    <meta name="description" content="{{ description | esc }}" />
    <link rel="canonical" href="{{ site.url }}{{ page | pageUrl }}" />
    <meta property="og:title" content="{{ title }} - {{ site.name }}" />
    <meta property="og:description" content="{{ description | esc }}" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="{{ site.url }}{{ page | pageUrl }}" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    {#- Autodiscovery: a feed nobody can find is a feed nobody reads. -#}
    <link rel="alternate" type="application/rss+xml" title="{{ site.name }} updates" href="/feed.xml" />
    <link rel="stylesheet" href="/assets/site.css" />
    <link rel="alternate" type="application/rss+xml" title="{{ site.name }} updates" href="{{ site.url }}/feed.xml" />
  </head>
  <body>
    <div class="shell">
      {#- The top bar, and the ONE build constraint the design states
          outright: it must render identically here and in the app. The
          two halves are cached differently and cannot agree on a shape
          that varies by session, so this carries no signed-in state at
          all — same markup, same classes, same six tabs, same gold
          Console button as apps/web/src/App.jsx renders. Session
          identity lives at the foot of the console's rail, which only
          the app draws.

          It used to show "Sign in" here and swap it to "Account" once
          /api/me answered, which is the reshaping-nav clunk that whole
          exercise was trying to remove. Console leads somewhere real
          either way: signed in it is the console, signed out it is the
          wall that offers sign-in. -#}
      <header class="chrome">
        <div class="chrome__inner">
          <a class="wordmark" href="/">{{ site.name }}</a>
          {#- The SAME markup as apps/web renders, at every width: which
              one is showing is a media query's decision, not this
              template's and not the app's. That is what keeps the two
              bars one bar. -#}
          <nav class="chrome__nav" aria-label="{{ site.name }}">
            <a class="chrome__tab{% if navActive == "home" %} chrome__tab--on{% endif %}" href="/">Home</a>
            <a class="chrome__tab{% if navActive == "data" %} chrome__tab--on{% endif %}" href="/data">Data</a>
            <a class="chrome__tab{% if navActive == "examples" %} chrome__tab--on{% endif %}" href="/examples/play">Examples</a>
            <a class="chrome__tab{% if navActive == "updates" %} chrome__tab--on{% endif %}" href="/updates">Updates</a>
            <a class="chrome__tab{% if navActive == "docs" %} chrome__tab--on{% endif %}" href="/docs">Docs</a>
            <a class="chrome__tab{% if navActive == "family" %} chrome__tab--on{% endif %}" href="/family">Family</a>
          </nav>
          {#- Never inside the menu, at any width. -#}
          <a class="chrome__console" href="/account/overview">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex: 0 0 auto"><path d="m12 14 4-4"/><path d="M3.34 19a10 10 0 1 1 17.32 0"/></svg>
            Console
          </a>
          <button type="button" class="chrome__menu" aria-label="Menu" aria-expanded="false" aria-controls="chrome-sheet" data-chrome-menu>
            <svg data-menu-open width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="18" y2="18"/></svg>
            <svg data-menu-close hidden width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
          </button>
        </div>

        <nav class="chrome__sheet" id="chrome-sheet" aria-label="{{ site.name }} menu" data-open="false">
          <a href="/"{% if navActive == "home" %} aria-current="page"{% endif %}>Home</a>
          <a href="/data"{% if navActive == "data" %} aria-current="page"{% endif %}>Data</a>
          <a href="/examples/play"{% if navActive == "examples" %} aria-current="page"{% endif %}>Examples</a>
          <a href="/updates"{% if navActive == "updates" %} aria-current="page"{% endif %}>Updates</a>
          <a href="/docs"{% if navActive == "docs" %} aria-current="page"{% endif %}>Docs</a>
          <a href="/family"{% if navActive == "family" %} aria-current="page"{% endif %}>Family</a>
        </nav>
      </header>

      {% if nav2 %}
      <nav class="nav2" aria-label="{{ nav2Label }} pages">
        <div class="nav2__inner wrap">
          {%- for item in nav2 %}
          <a href="{{ item.url }}"{% if item.url == (page | pageUrl) %} aria-current="page"{% endif %}>{{ item.label }}</a>
          {%- endfor %}
        </div>
      </nav>
      {% endif %}

      <main class="wrap{% if prose %} wrap--prose{% endif %}">
        {{ content | safe }}
      </main>

      <footer class="disclaimer">
        <span class="disclaimer__tag">UNOFFICIAL</span>
        <span class="disclaimer__text">
          This material is unofficial and is not endorsed by Supercell. For more
          information see Supercell&rsquo;s Fan Content Policy:
          <a href="https://www.supercell.com/fan-content-policy">www.supercell.com/fan-content-policy</a>.
        </span>
        <span class="disclaimer__family">{{ site.family }}</span>
      </footer>
    </div>
    {#- Tinylytics: a static page is a real document load, so the embed
        records the hit by itself. No pushState bridge is needed here -
        that belongs to the app. Same privacy posture: anonymous only. -#}
    {#- The narrow menu. External file, never inline: the CSP forbids
        inline script and a test pins that. -#}
    <script defer src="/assets/chrome-menu.js"></script>
    <script defer src="https://tinylytics.app/embed/{{ site.tinylyticsId }}/min.js?hits&countries&events"></script>
  </body>
</html>
