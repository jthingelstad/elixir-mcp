---
layout: base.njk
navActive: family
pagination:
  data: familyFlat
  size: 1
  addAllPagesToCollections: true
  alias: p
permalink: "{{ p | familyPath(p.first) }}"
eleventyComputed:
  title: "{{ p.label }}"
  description: "{{ p.lede }}"
---
{#-
  One page per product, as the design draws it: the rail lists every
  project under its group with a glyph and marks here / beta / theirs;
  the page carries the byline, kind and state, the title, the lede, the
  links (the first external one gold), the screenshot slot, Highlights
  or Why we like it, How it fits, and three siblings.

  Two kinds of project, two bylines, and no cross-selling between them:
  ours say how they fit the hub, theirs say plainly that they are not
  connected to us. Recommending somebody else's work in the voice you
  use to sell your own is what makes both untrustworthy.
-#}
<div class="siterail">
  <aside class="siterail__nav" data-siterail data-open="false">
    <button type="button" class="siterail__head" data-rail-toggle aria-expanded="false" aria-controls="family-rail">
      <span class="siterail__head-title">Family</span>
      <span class="siterail__head-here">{{ p.label }}</span>
      <span class="siterail__head-meta">{{ p.count }}<span class="siterail__head-chevron">{% icon "chevron-down", 17 %}</span></span>
    </button>
    <nav class="siterail__list" id="family-rail" aria-label="Projects">
      {%- for g in family %}
      <div class="rail__group">{{ g.group }}</div>
      {%- for q in g.projects %}
      <a class="rail__item{% if q.key == p.key %} rail__item--on{% endif %}" href="{{ q | familyPath(loop.first and g.group == family[0].group) | replace('/index.html', '') | replace('/family/', '/family/') }}"{% if q.key == p.key %} aria-current="page"{% endif %}>
        {% icon q.icon, 18 %}{{ q.label }}
        <span class="rail__meta">{% if q.here %}here{% elif q.state == "beta" %}beta{% elif g.theirs %}theirs{% endif %}</span>
      </a>
      {%- endfor %}
      {%- endfor %}
    </nav>
    <div class="siterail__foot">
      Each one reads from the hub. None of them reaches into another.
    </div>
  </aside>

  <div class="siterail__body">
    <div style="display: flex; align-items: center; gap: 10px; flex-wrap: wrap; margin-bottom: 12px">
      <span style="font-size: 12.5px; color: var(--ink-faint)">{% if p.theirs %}Not ours &mdash; we just rate it{% else %}Run by POAP KINGS{% endif %}</span>
      <span class="tag-chip">{{ p.kind }}</span>
      <span class="chip {% if p.state == 'live' %}chip--ok{% else %}chip--warn{% endif %}"><span class="chip__dot"></span>{{ p.state }}</span>
    </div>
    <h1 class="hero-title" style="font-size: 38px; margin: 0 0 10px">{{ p.label }}</h1>
    <p class="docs__lede" style="max-width: 62ch; margin-bottom: 22px">{{ p.lede }}</p>

    {%- if p.links and p.links.length %}
    <div style="display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 24px">
      {%- for l in p.links %}
      <a class="btn{% if loop.first and l[1] == 'external' %} btn--primary{% endif %}" href="{{ l[2] }}"{% if l[1] == 'external' %} rel="noopener"{% endif %}>{{ l[0] }} {% icon "arrow-right", 15 %}</a>
      {%- endfor %}
    </div>
    {%- endif %}

    {#- A slot, not an illustration: a described placeholder is honest
        about a screenshot that does not exist yet, where a drawing of a
        product nobody has seen is not. -#}
    <div style="height: 400px; margin-bottom: 18px; border-radius: 16px; border: 1px dashed var(--line); background: var(--panel-float); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px; color: var(--ink-faint)">
      {% icon "image", 28 %}
      <span class="footnote">{{ p.shot }}</span>
    </div>

    <div style="display: flex; gap: 18px; flex-wrap: wrap">
      <section class="panel" style="flex: 1 1 300px">
        <div class="panel__head">{% if p.theirs %}Why we like it{% else %}Highlights{% endif %}</div>
        <div class="panel__body" style="display: flex; flex-direction: column; gap: 11px">
          {%- for point in p.points %}
          <span style="display: flex; align-items: flex-start; gap: 10px; font-size: 14px; line-height: 1.55; color: var(--ink-body)">
            <span style="width: 5px; height: 5px; border-radius: 999px; background: var(--accent-bright); flex: 0 0 auto; margin-top: 7px"></span>{{ point }}
          </span>
          {%- endfor %}
        </div>
      </section>
      <section class="panel" style="flex: 1 1 280px">
        <div class="panel__head">{% if p.theirs %}Where it stands{% else %}How it fits{% endif %}</div>
        <div class="panel__body" style="font-size: 13.5px; line-height: 1.65; color: var(--ink-body)">{{ p.uses }}</div>
        {%- if not p.theirs %}
        <div class="panel__foot">Hub-and-spoke: the hub records, each product pulls what it needs with its own credential.</div>
        {%- endif %}
      </section>
    </div>

    {%- if p.siblings.length %}
    <div style="margin-top: 26px; padding-top: 20px; border-top: 1px solid var(--line-soft)">
      <div class="label" style="margin-bottom: 12px">{% if p.theirs %}More we like{% else %}Also in the family{% endif %}</div>
      <div style="display: flex; gap: 12px; flex-wrap: wrap">
        {%- for s in p.siblings %}
        <a class="rail-card" href="{{ s | familyPath(s.key == familyFlat[0].key) | replace('/index.html', '') }}">
          <span class="rail-card__title">{% icon s.icon, 17 %}{{ s.label }}</span>
          <span class="rail-card__lede">{{ s.lede | truncate(120) }}</span>
        </a>
        {%- endfor %}
      </div>
    </div>
    {%- endif %}
  </div>
</div>

<script defer src="/assets/site-rail.js"></script>
