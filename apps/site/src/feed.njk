---
permalink: /feed.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ site.name }} updates</title>
    <link>{{ site.url }}/updates</link>
    <description>Every user-visible change to {{ site.name }} and every tool contract version, newest first.</description>
    <language>en</language>
    {#- rel=self: validators and some readers want the feed to name its own
        address, and it is how a moved feed is recognised as the same feed. -#}
    <atom:link href="{{ site.url }}/feed.xml" rel="self" type="application/rss+xml" />
    <lastBuildDate>{{ feedItems[0].date | rfc822 }}</lastBuildDate>
    {#- The GUID is the entry's own page (_data/feedItems.js): stable across
        ships, and a link that resolves. -#}
    {%- for u in feedItems %}
    <item>
      <title>{{ u.title }}</title>
      <link>{{ u.url }}</link>
      <guid isPermaLink="true">{{ u.url }}</guid>
      <category>{{ u.kind }}</category>
      <pubDate>{{ u.date | rfc822 }}</pubDate>
      <description>{{ u.body | md }}</description>
    </item>
    {%- endfor %}
  </channel>
</rss>
