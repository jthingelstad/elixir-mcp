---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
{#- Only pages that serve real HTML. The application's chart and console
    routes render nothing without JavaScript, so listing them would
    point crawlers at an empty shell - which is exactly what the old
    hand-written sitemap did for all ten of its entries. -#}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for p in collections.all %}
{%- if not p.data.eleventyExcludeFromCollections and p.url %}
  <url><loc>{{ site.url }}{{ p | pageUrl }}</loc></url>
{%- endif %}
{%- endfor %}
</urlset>
