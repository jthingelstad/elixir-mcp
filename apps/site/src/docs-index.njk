{#-
  The docs home: one card per thing a person comes to do, the New here band
  for someone signed out, and the three parents as panels. A card links only
  pages that exist (`docPages` leaves out a slug no page has yet).
-#}
{%- set tasks = [
  { icon: "chart-line", title: "See how I am doing", product: "Stats",
    text: "Your season as Elixir recorded it, one mode at a time: your battles, record and win rate week by week, and the deck you played most.",
    slugs: ["ladder"] },
  { icon: "users", title: "Run my clan", product: "Clan",
    text: "Your leaders write down how the clan runs. Clan reads the record against it and hands them the calls to make.",
    slugs: ["bring-your-clan", "standing", "clan-actions"] },
  { icon: "heart", title: "Follow my friends", product: "Friends",
    text: "Follow friends, watch any player, and get a Wednesday email on how each of them did.",
    slugs: ["follow-a-friend", "watch-a-player"] },
  { icon: "mail", title: "Get emails", product: "Emails",
    text: "What each email holds, when it lands, and the switch for every one.",
    slugs: ["email", "milestones", "turn-an-email-off"] },
  { icon: "bot", title: "Ask my AI", product: "MCP",
    text: "Connect Claude or any MCP client to your whole record. Which tool answers which question, and how to read the answers.",
    slugs: ["connections", "choosing-a-tool", "tools"] },
  { icon: "code", title: "Build on Elixir", product: "Developers",
    text: "Sign in with Elixir, the JSON API and integration keys, and running a collector of your own.",
    slugs: ["sign-in-with-elixir", "json-api", "integrations", "operators"] }
] %}
{%- set panels = [
  { title: "Use Elixir", text: "What each page shows and how to read it: your stats, your clan, your friends, your emails, your account.",
    links: [["Welcome", "/docs/about"]] },
  { title: "Connect an AI", text: "Connect a client, what your agent can read, which tool answers what, and ten recorded examples.",
    links: [["Connect an agent", "/docs/connections"], ["All examples", "/examples"]] },
  { title: "Build & reference", text: "What every number means, for people and agents alike. The tool reference, the protocol, and these pages read by a machine.",
    links: [["What Elixir records", "/docs/recording"], ["Tools", "/docs/tools"]] }
] %}
<nav class="docs__crumb" aria-label="Breadcrumb"><span aria-current="page">Docs</span></nav>
<h1 class="hero-title docs__title">Elixir docs</h1>
<p class="docs__lede">Elixir keeps your Clash Royale record and reads it back to you: in your stats, in your clan, by email and through your own AI. Start with what you want to do.</p>

<div class="docs-tasks">
  {%- for t in tasks %}
  {%- set pages = collections.docs | docPages(t.slugs) %}
  {%- if pages.length %}
  <section class="docs-task" aria-labelledby="task-{{ loop.index }}">
    <div class="docs-task__head">
      <span class="docs-task__icon">{% icon t.icon, 17 %}</span>
      <h2 class="docs-task__title" id="task-{{ loop.index }}">{{ t.title }}</h2>
      <span class="docs-task__product">{{ t.product }}</span>
    </div>
    <p class="docs-task__text">{{ t.text }}</p>
    <div class="docs-task__links">
      {%- for d in pages %}
      <a href="{{ d | pageUrl }}">{{ d.data.navTitle or d.data.title }}</a>
      {%- endfor %}
    </div>
  </section>
  {%- endif %}
  {%- endfor %}
</div>

<div class="docs-new" data-session-face="out">
  {% icon "rocket", 18 %}
  <p><b>New here?</b> Create a free account, add your player tag, and Elixir starts recording it. Connecting an AI is optional.</p>
  <a class="btn btn--gold" href="/docs/quickstart">Quickstart</a>
</div>

<div class="docs-tops">
  {%- for p in panels %}
  <section class="docs-task">
    <div class="docs-task__head"><h2 class="docs-task__title">{{ p.title }}</h2></div>
    <p class="docs-task__text">{{ p.text }}</p>
    <div class="docs-task__links">
      {%- for l in p.links %}
      <a href="{{ l[1] }}">{{ l[0] }}</a>
      {%- endfor %}
    </div>
  </section>
  {%- endfor %}
</div>
