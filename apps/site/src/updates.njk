<div class="page-head">
  <h1 class="page-title">What&rsquo;s new</h1>
  <p class="page-head__note">Every user-visible change, newest first. For the tool contract specifically, see the <a href="/data/changelog">changelog</a>.</p>
  <a class="feed-link" href="/feed.xml" title="Subscribe to Elixir MCP updates">
    <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <circle cx="5" cy="19" r="2.6"/>
      <path d="M2.4 10.6a1.9 1.9 0 0 1 0-3.8A15.3 15.3 0 0 1 17.6 22a1.9 1.9 0 0 1-3.8 0A11.5 11.5 0 0 0 2.4 10.6z"/>
      <path d="M2.4 3.8a1.9 1.9 0 0 1 0-3.8h.1A22 22 0 0 1 24 22a1.9 1.9 0 0 1-3.8 0A18.2 18.2 0 0 0 2.4 3.8z"/>
    </svg>
    RSS
  </a>
</div>

{%- for u in updates %}
<section class="panel" style="margin-bottom: var(--s-4)" id="{{ u.date }}-{{ loop.index }}">
  <div class="panel__head">
    <span class="panel-title">{{ u.title }}</span>
    <time class="mono" style="margin-left: auto; font-size: 11px; color: var(--dim)" datetime="{{ u.date }}">{{ u.date }}</time>
  </div>
  <div class="panel__body"><p style="color: var(--muted); margin: 0">{{ u.body }}</p></div>
</section>
{%- endfor %}
