---
layout: base.njk
title: "Cards"
description: "The recorded Clash Royale card catalog: names, rarity, elixir cost and available forms."
permalink: /cards/index.html
canonical: /cards
navActive: cards
---
<div class="flex flex-col gap-[22px] pt-8 pb-2" data-cards-index>
  <div class="flex flex-wrap items-end gap-x-6 gap-y-3">
    <div class="flex min-w-0 flex-auto flex-col gap-2">
      <h1 class="hero-title m-0">Cards</h1>
      <p class="lede m-0 max-w-[70ch]" data-cards-lede>
        The recorded Clash Royale catalog: card names, rarity, elixir cost and available forms.
      </p>
    </div>
  </div>

  <div class="flex flex-col gap-[14px]" data-cards-controls hidden>
    <div class="flex flex-wrap items-center gap-[14px]">
      <label class="card-search">
        {% icon "search", 16 %}
        <input type="search" placeholder="Find a card" aria-label="Find a card" autocomplete="off" data-cards-search />
      </label>
      <span class="flex-auto"></span>
      <label class="flex items-center gap-2 text-[12.5px] text-ink-faint">
        Sort
        <select class="select" data-cards-sort>
          <option value="elixir">Elixir cost</option>
          <option value="name">Name</option>
        </select>
      </label>
    </div>
    <div class="flex flex-wrap items-center gap-2">
      <span class="mr-1 text-[12.5px] text-ink-faint" id="rarity-label">Rarity</span>
      <div class="flex flex-wrap gap-2" role="group" aria-labelledby="rarity-label" data-cards-rarity>
        {%- for r in [["", "All"], ["common", "Common"], ["rare", "Rare"], ["epic", "Epic"], ["legendary", "Legendary"], ["champion", "Champion"]] %}
        <button type="button" class="card-filter" data-value="{{ r[0] }}" aria-pressed="{{ 'true' if r[0] == '' else 'false' }}">{{ r[1] }}</button>
        {%- endfor %}
      </div>
      <span class="mx-[6px] h-5 w-px bg-line max-wide:hidden" aria-hidden="true"></span>
      <span class="mr-1 text-[12.5px] text-ink-faint" id="elixir-label">Elixir</span>
      <div class="flex flex-wrap gap-2" role="group" aria-labelledby="elixir-label" data-cards-elixir>
        {%- for e in ["1", "2", "3", "4", "5", "6", "7+"] %}
        <button type="button" class="card-filter card-filter--round" data-value="{{ e }}" aria-pressed="false">{{ e }}</button>
        {%- endfor %}
      </div>
    </div>
  </div>

  {%- if cards.length %}
  <ul class="m-0 grid list-none grid-cols-[repeat(auto-fill,minmax(240px,1fr))] gap-[14px] p-0" data-cards-grid>
    {%- for card in cards %}
    <li data-name="{{ card.name }}" data-rarity="{{ card.rarity }}" data-elixir="{{ card.elixir }}">
      <a class="card-tile" href="/cards/{{ card.id }}/">
        <span class="card-tile__art">
          <span class="card-art"><span class="card-art__frame"><img class="card-art__img" src="{{ card.art.tile }}" alt="" width="43" height="63" loading="lazy" data-name="{{ card.name }}" /></span></span>
          <span class="card-elixir" aria-label="{{ card.elixir }} elixir">{{ card.elixir }}</span>
        </span>
        <span class="card-tile__body">
          <span class="card-tile__head"><span class="card-tile__name">{{ card.name }}</span></span>
          <span class="card-tile__kind">{{ card.rarity | capitalize }} {{ card.type }}{% if card.formsLabel %} &middot; {{ card.formsLabel }}{% endif %}</span>
        </span>
      </a>
    </li>
    {%- endfor %}
  </ul>
  {%- else %}
  <p class="footnote m-0">
    The card list is built from Elixir&rsquo;s catalog, and this build had
    none to read. It arrives with the next build.
  </p>
  {%- endif %}

</div>
<script defer src="{{ "/assets/cards-index.js" | asset }}"></script>
