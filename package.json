{
  "name": "elixir-mcp",
  "private": true,
  "version": "0.0.0",
  "description": "Clash Royale history recorder + remote MCP server. Unofficial; not endorsed by Supercell.",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@aws-sdk/client-cloudformation": "^3.1130.0",
    "@aws-sdk/client-cloudfront": "^3.1130.0",
    "@aws-sdk/client-iam": "^3.1130.0",
    "@aws-sdk/client-lambda": "^3.1130.0",
    "@aws-sdk/client-s3": "^3.1130.0",
    "@aws-sdk/client-secrets-manager": "^3.1130.0",
    "@aws-sdk/client-sts": "^3.1130.0",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "esbuild": "^0.28.2",
    "knip": "^6.35.1",
    "oxlint": "^1.82.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "build": "npm run build -w @elixir-mcp/design && npm run build -w @elixir-mcp/contracts && npm run build -w @elixir-mcp/docs",
    "pretest": "npm run build",
    "test": "npm test -ws --if-present && node --test \"AGENT-TEAM/scripts/**/*.test.mjs\" \"clients/**/*.test.mjs\"",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "typecheck": "tsc -p apps/web && tsc -p packages/client && tsc -p packages/ui",
    "verify": "npm run format:check && npm run lint && npm run knip && npm run typecheck && npm run test",
    "cr": "node infra/scripts/cr-api.mjs",
    "e2e": "playwright test -c apps/web/playwright.config.ts"
  }
}
