{
  "name": "elixir-mcp",
  "private": true,
  "version": "0.0.0",
  "description": "Clash Royale history recorder + remote MCP server. Unofficial; not endorsed by Supercell.",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@aws-sdk/client-cloudformation": "^3.1125.0",
    "@aws-sdk/client-cloudfront": "^3.1125.0",
    "@aws-sdk/client-iam": "^3.1125.0",
    "@aws-sdk/client-lambda": "^3.1125.0",
    "@aws-sdk/client-s3": "^3.1125.0",
    "@aws-sdk/client-secrets-manager": "^3.1125.0",
    "@aws-sdk/client-sts": "^3.1125.0",
    "esbuild": "^0.28.2",
    "knip": "^6.34.0",
    "oxlint": "^1.81.0",
    "prettier": "^3.9.6"
  },
  "scripts": {
    "build": "npm run build -w @elixir-mcp/contracts",
    "test": "npm test -ws --if-present",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "verify": "npm run format:check && npm run lint && npm run knip && npm run test"
  }
}
