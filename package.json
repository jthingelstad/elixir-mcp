{
  "name": "elixir-mcp",
  "private": true,
  "version": "0.0.0",
  "description": "Clash Royale history recorder + remote MCP server. Unofficial; not endorsed by Supercell.",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "@tailwindcss/cli": {
      "@parcel/watcher": "^2.6.0"
    }
  },
  "devDependencies": {
    "@aws-sdk/client-cloudformation": "^3.1156.0",
    "@aws-sdk/client-cloudfront": "^3.1156.0",
    "@aws-sdk/client-lambda": "^3.1156.0",
    "@aws-sdk/client-lambda-web": "3.1156.0",
    "@aws-sdk/client-s3": "^3.1156.0",
    "@aws-sdk/client-secrets-manager": "^3.1156.0",
    "@aws-sdk/client-sts": "^3.1156.0",
    "@axe-core/playwright": "^4.14.0",
    "@elixir-mcp/clan-engine": "0.1.0",
    "@playwright/test": "^1.64.1",
    "@tanstack/router-core": "1.171.38",
    "esbuild": "^0.28.2",
    "knip": "^6.41.0",
    "oxlint": "^1.88.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "build": "npm run build -w @elixir-mcp/design && npm run build -w @elixir-mcp/contracts && npm run build -w @elixir-mcp/docs",
    "test": "node infra/scripts/test.mjs",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "typecheck": "tsc -p apps/web && tsc -p packages/client && tsc -p packages/ui && tsc -p packages/clan-web",
    "verify:static": "npm run format:check && npm run lint && npm run knip && npm run typecheck",
    "verify": "npm run verify:static && npm test && node infra/scripts/build.mjs",
    "acceptance": "npm run build && node acceptance/run.mjs",
    "cr": "node infra/scripts/cr-api.mjs",
    "op": "node infra/scripts/op.mjs",
    "editor-replay": "node infra/scripts/editor-replay.mjs",
    "contract:bump": "node packages/contracts/scripts/bump.mjs",
    "e2e": "playwright test -c apps/web/playwright.config.ts"
  }
}
