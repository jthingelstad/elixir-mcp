{
  "openapi": "3.1.0",
  "info": {
    "title": "Elixir JSON API",
    "version": "1.3.0",
    "description": "The versioned JSON API, Elixir's public product beside MCP. Two kinds of caller: an integration by its integration_api key, and a person by an OAuth grant whose audience is https://elixir.poapkings.com/api/v1. An MCP token is refused here, and a token for this API is refused at MCP. Each operation names the callers it admits (x-principals; none named means integration). Supplied tags are unverified. Collection grants allow additions only."
  },
  "servers": [
    {
      "url": "https://elixir.poapkings.com/api/v1"
    }
  ],
  "security": [
    {
      "integrationKey": []
    }
  ],
