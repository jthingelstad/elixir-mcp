{
  "openapi": "3.1.0",
  "info": {
    "title": "Elixir JSON API",
    "version": "5.0.0",
    "description": "What Sign in with Elixir needs: GET /me, who the person signed in through an app is (their account id, their principal and their players), for a person's OAuth grant whose audience is https://elixir.poapkings.com/api/v1. An MCP token is refused here, and a token for this API is refused at MCP. 5.0.0 removed the integration keys and every other operation (\"No integrations: Elixir has users and agents\", 2026-11-13). This material is unofficial and is not endorsed by Supercell. For more information see Supercell's Fan Content Policy: www.supercell.com/fan-content-policy."
  },
  "servers": [
    {
      "url": "https://elixir.poapkings.com/api/v1"
    }
  ],
  "security": [
    {
      "personOAuth": ["cr:read"]
    }
  ],
  "paths": {
    "/me": {
      "get": {
        "operationId": "me",
        "summary": "Who the signed-in person is to Elixir: their account id, their principal and the players they follow.",
        "x-principals": ["person"],
        "security": [
          {
            "personOAuth": ["cr:read"]
          }
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "Success",
            "headers": {
              "X-Request-ID": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            }
          },
          "default": {
            "description": "Failure. Retry-After is supplied for throttling and temporary failures.",
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "string"
                }
              },
              "X-Request-ID": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "personOAuth": {
        "type": "oauth2",
        "description": "A person's OAuth 2.1 grant (PKCE) with resource https://elixir.poapkings.com/api/v1 and scope cr:read. Clients provisioned as the Elixir family's own apps are first-party and are not metered; other clients are limited to 600 calls per person per hour.",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "https://elixir.poapkings.com/oauth/authorize",
            "tokenUrl": "https://elixir.poapkings.com/oauth/token",
            "scopes": {
              "cr:read": "Read who you are and your players; every grant holds it",
              "account:email": "The account's address, on /me and /oauth/userinfo; family apps only"
            }
          }
        }
      }
    },
    "schemas": {
      "Problem": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "description": "https://elixir.poapkings.com/docs/sign-in-with-elixir/#errors"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "code": {
            "type": "string",
            "description": "The closed error code: unauthenticated, not_found, invalid_json, rate_limited (a third-party client past 600 calls an hour for one person), timeout, temporarily_unavailable, internal."
          },
          "detail": {
            "type": "string"
          },
          "request_id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": ["type", "title", "status", "code", "detail", "request_id"]
      },
      "MeResponse": {
        "type": "object",
        "required": ["data", "request_id"],
        "properties": {
          "request_id": {
            "type": "string"
          },
          "data": {
            "type": "object",
            "required": ["account_id", "principal", "players"],
            "properties": {
              "account_id": {
                "type": "string",
                "description": "The account's id, the same value /oauth/userinfo answers as sub: stable for the account's life (5.0.0)."
              },
              "principal": {
                "type": "object",
                "description": "The same block MCP initialize carries in _meta: kind, subject (the primary player) and clan.",
                "required": ["kind"],
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": ["person"]
                  },
                  "subject": {
                    "type": ["object", "null"],
                    "properties": {
                      "type": {
                        "type": "string"
                      },
                      "tag": {
                        "type": "string"
                      },
                      "name": {
                        "type": "string"
                      }
                    }
                  },
                  "clan": {
                    "type": "object",
                    "properties": {
                      "tag": {
                        "type": "string"
                      },
                      "name": {
                        "type": "string"
                      }
                    }
                  }
                }
              },
              "players": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "player_tag",
                    "relationship",
                    "is_primary",
                    "claim_status",
                    "recording"
                  ],
                  "properties": {
                    "player_tag": {
                      "type": "string"
                    },
                    "name": {
                      "type": ["string", "null"]
                    },
                    "nickname": {
                      "type": "string"
                    },
                    "relationship": {
                      "type": "string",
                      "enum": ["primary", "alt", "friend", "watching"]
                    },
                    "is_primary": {
                      "type": "boolean"
                    },
                    "claim_status": {
                      "type": "string"
                    },
                    "notify": {},
                    "recording": {
                      "type": "string"
                    },
                    "clan_tag": {
                      "type": ["string", "null"]
                    },
                    "clan_role": {
                      "type": ["string", "null"]
                    },
                    "clan_name": {
                      "type": ["string", "null"],
                      "description": "The clan's name beside clan_tag (1.3.0)."
                    }
                  }
                }
              },
              "email": {
                "type": ["string", "null"],
                "description": "The account's address, present only for an Elixir family app (every redirect on a family origin) whose grant holds account:email (2.1.0)."
              }
            }
          }
        }
      }
    }
  }
}
