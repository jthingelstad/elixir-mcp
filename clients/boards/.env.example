# Copy to .env (mode 0600). The .env is ignored by git; this example is not.
# A service token for the account that OWNS the collections in BOARDS:
# Admin > Service tokens in the console, owner only, shown once.
ELIXIR_MCP_TOKEN=svt_replace_me
# Optional; defaults to the production door.
# ELIXIR_MCP_URL=https://elixir.poapkings.com/mcp
